<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

<!-- focusableInTouchMode: the initial focus goes here and not to the selectable log,
     otherwise the ScrollView would start scrolled to the bottom -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header with the brand -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/surface"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/ui_header_tagline"
                android:textColor="@color/brand_mint"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.75"
                android:fontFamily="monospace"
                android:textColor="@color/surface"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bridge status: API server, calls from the browser, Bluetooth, battery -->
    <LinearLayout style="@style/BridgeCard">

        <TextView
            style="@style/BridgeCardTitle"
            android:text="@string/ui_status_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/healthServerDot"
                style="@style/BridgeDot" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/BridgeRowTitle"
                    android:text="@string/ui_health_server_title" />

                <TextView
                    android:id="@+id/healthServerText"
                    style="@style/BridgeRowText"
                    android:text="..." />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/healthCallsDot"
                style="@style/BridgeDot" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/BridgeRowTitle"
                    android:text="@string/ui_health_calls_title" />

                <TextView
                    android:id="@+id/healthCallsText"
                    style="@style/BridgeRowText"
                    android:text="..." />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/healthBtDot"
                style="@style/BridgeDot" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/BridgeRowTitle"
                    android:text="@string/ui_health_bt_title" />

                <TextView
                    android:id="@+id/healthBtText"
                    style="@style/BridgeRowText"
                    android:text="..." />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/healthPowerDot"
                style="@style/BridgeDot" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/BridgeRowTitle"
                    android:text="@string/ui_health_power_title" />

                <TextView
                    android:id="@+id/healthPowerText"
                    style="@style/BridgeRowText"
                    android:text="..." />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnFixPower"
            style="@style/BridgeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ui_btn_fix_power"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSelfTest"
            style="@style/BridgeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ui_btn_self_test" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRestartServer"
                style="@style/BridgeButtonSecondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ui_btn_restart_server" />

            <Button
                android:id="@+id/btnProbeBt"
                style="@style/BridgeButtonSecondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/ui_btn_probe_bt" />
        </LinearLayout>
    </LinearLayout>

    <!-- Printer -->
    <LinearLayout style="@style/BridgeCard">

        <TextView
            style="@style/BridgeCardTitle"
            android:text="@string/ui_printer_title" />

        <TextView
            android:id="@+id/device"
            style="@style/BridgeValue"
            android:layout_marginTop="8dp"
            android:text="@string/ui_printer_device_none" />

        <TextView
            android:id="@+id/state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ui_printer_state_waiting"
            android:textColor="@color/brand_teal_dark"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detail"
            style="@style/BridgeRowText"
            android:layout_marginTop="2dp"
            android:text="" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPick"
                style="@style/BridgeButtonSecondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ui_btn_pick_printer" />

            <Button
                android:id="@+id/btnTest"
                style="@style/BridgeButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/ui_btn_test_print" />
        </LinearLayout>

        <Button
            android:id="@+id/btnForget"
            style="@style/BridgeButtonSecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ui_btn_forget_printer" />
    </LinearLayout>

    <!-- Test addresses: rows built in MainActivity, with Copy and Open -->
    <LinearLayout style="@style/BridgeCard">

        <TextView
            style="@style/BridgeCardTitle"
            android:text="@string/ui_urls_title" />

        <TextView
            style="@style/BridgeRowText"
            android:layout_marginTop="4dp"
            android:text="@string/ui_urls_hint" />

        <LinearLayout
            android:id="@+id/urlList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- Receipt paper and logo -->
    <LinearLayout style="@style/BridgeCard">

        <TextView
            style="@style/BridgeCardTitle"
            android:text="@string/ui_paper_logo_title" />

        <TextView
            style="@style/BridgeLabel"
            android:layout_marginTop="8dp"
            android:text="@string/ui_paper_width_label" />

        <TextView
            android:id="@+id/paperValue"
            style="@style/BridgeValue"
            android:text="@string/ui_paper_value_default" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/paper58"
                style="@style/BridgeButtonSecondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ui_btn_paper_58" />

            <Button
                android:id="@+id/paper80"
                style="@style/BridgeButtonSecondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/ui_btn_paper_80" />
        </LinearLayout>

        <TextView
            style="@style/BridgeLabel"
            android:layout_marginTop="12dp"
            android:text="@string/ui_logo_label" />

        <TextView
            android:id="@+id/logoStatus"
            style="@style/BridgeValue"
            android:text="@string/ui_logo_none" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLogoUrl"
                style="@style/BridgeButtonSecondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ui_btn_logo_url" />

            <Button
                android:id="@+id/btnLogoFile"
                style="@style/BridgeButtonSecondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/ui_btn_logo_file" />

            <Button
                android:id="@+id/btnLogoClear"
                style="@style/BridgeButtonSecondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/ui_btn_logo_clear" />
        </LinearLayout>
    </LinearLayout>

    <!-- Log -->
    <LinearLayout style="@style/BridgeCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/BridgeCardTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/ui_log_title" />

            <Button
                android:id="@+id/btnCopyLog"
                style="@style/BridgeButtonSmallSecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_btn_copy_log" />
        </LinearLayout>

        <TextView
            style="@style/BridgeRowText"
            android:layout_marginTop="2dp"
            android:text="@string/ui_log_hint" />

        <!-- Fixed height: the page scrolls in the outer ScrollView, the log in its own -->
        <ScrollView
            android:id="@+id/logScroll"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_log"
            android:nestedScrollingEnabled="true"
            android:padding="10dp">

            <TextView
                android:id="@+id/log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/ui_log_ready"
                android:textColor="@color/log_text"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </ScrollView>
    </LinearLayout>

    <Button
        android:id="@+id/btnBack"
        style="@style/BridgeButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/ui_btn_back" />
</LinearLayout>
</ScrollView>
